# Configuration de la Base de Données
DB_URL=jdbc:mysql://localhost:3306/muscul_ia_db
DB_USERNAME=root
DB_PASSWORD=your_secure_password

# Configuration JWT
JWT_SECRET=your_very_secure_jwt_secret_key_here_make_it_long_and_random
JWT_EXPIRATION=86400000

# Configuration de l'Application
APP_ENVIRONMENT=development

# Configuration de Sécurité
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure_admin_password

# Configuration CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# Configuration de Logging (optionnel)
LOG_LEVEL=DEBUG
LOG_FILE_PATH=logs/muscul-ia.log

# Configuration de Monitoring (optionnel)
ENABLE_METRICS=true
ENABLE_HEALTH_CHECK=true 